---
import Wrapper from './Wrapper.astro';
import { img } from '../../lib/util';
import type { Section } from '../../lib/sections';
interface Props { section: Section }
const { section } = Astro.props;
const d = section.data;
---
<Wrapper section={section} class="py-20 lg:py-32">
  <div class="blob -top-24 -left-24 h-80 w-80 bg-primary" aria-hidden="true"></div>
  <div class="blob -right-20 -bottom-32 h-96 w-96 bg-secondary" aria-hidden="true"></div>
  <div class="relative grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div class="hero-in order-2 lg:order-1">
      <h1 class="mb-6 text-4xl leading-tight font-bold text-accent sm:text-5xl lg:text-6xl">
        {d.heading}{d.highlight && <><br /><span class="text-shimmer">{d.highlight}</span></>}
      </h1>
      {d.text && <p class="mb-8 text-xl leading-relaxed text-ink/85">{d.text}</p>}
      {(d.primaryLabel || d.secondaryLabel) && (
        <div class="flex flex-col gap-4 sm:flex-row">
          {d.primaryLabel && <a href={d.primaryLink} class="btn-primary px-8 py-4 text-lg">{d.primaryLabel}</a>}
          {d.secondaryLabel && <a href={d.secondaryLink} class="btn-outline px-8 py-4 text-lg">{d.secondaryLabel}</a>}
        </div>
      )}
    </div>
    {d.image && (
      <div class="hero-photo relative order-1 mx-auto w-full max-w-md lg:order-2">
        <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-2xl border-2 border-primary/60" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-2xl shadow-2xl">
          <img src={img(d.image, 800, 800)} alt={d.highlight || d.heading} width="800" height="800"
            class="w-full scale-110" data-parallax fetchpriority="high" />
        </div>
      </div>
    )}
  </div>
</Wrapper>
