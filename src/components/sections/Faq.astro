---
import Wrapper from './Wrapper.astro';
import Heading from './Heading.astro';
import Icon from '../Icon.astro';
import { paragraphs } from '../../lib/util';
import type { Section } from '../../lib/sections';
interface Props { section: Section }
const { section } = Astro.props;
const d = section.data;
---
<Wrapper section={section}>
  <Heading heading={d.heading} intro={d.intro} />
  <div class="mx-auto max-w-3xl space-y-3" data-stagger>
    {d.items.map((q: any) => (
      <details class="group rounded-xl bg-white p-6 text-ink shadow transition-shadow duration-300 hover:shadow-lg open:shadow-lg" data-reveal>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-accent">
          {q.question}
          <Icon name="chevron-down" class="shrink-0 transition-transform group-open:rotate-180" />
        </summary>
        <div class="mt-4 space-y-3 opacity-90">{paragraphs(q.answer).map((p) => <p>{p}</p>)}</div>
      </details>
    ))}
  </div>
</Wrapper>
