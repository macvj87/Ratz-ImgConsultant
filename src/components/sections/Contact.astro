---
import Wrapper from './Wrapper.astro';
import Heading from './Heading.astro';
import Icon from '../Icon.astro';
import type { Section } from '../../lib/sections';
import type { Settings } from '../../lib/store';
interface Props { section: Section; settings: Settings }
const { section, settings: s } = Astro.props;
const d = section.data;
const hours = s.hours.split('\n').filter(Boolean);
const details = [
  s.location && { icon: 'map-pin', title: 'Location', lines: [s.location], note: s.locationNote },
  s.phone && { icon: 'phone', title: 'Phone', lines: [s.phone], href: `tel:${s.phone.replace(/\s/g, '')}` },
  s.email && { icon: 'mail', title: 'Email', lines: [s.email], href: `mailto:${s.email}` },
  hours.length && { icon: 'clock', title: 'Hours', lines: hours },
].filter(Boolean) as { icon: 'map-pin' | 'phone' | 'mail' | 'clock'; title: string; lines: string[]; note?: string; href?: string }[];
const socials = (['instagram', 'facebook', 'linkedin'] as const).filter((k) => s[k]);
---
<Wrapper section={section}>
  <Heading heading={d.heading} intro={d.intro} />
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
    <div data-reveal="left">
      <h3 class="mb-8 text-2xl font-bold text-accent">Get in touch</h3>
      <div class="space-y-6" data-stagger>
        {details.map((c) => (
          <div class="group flex items-start gap-4">
            <span class="rounded-lg bg-primary p-3 text-white transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6"><Icon name={c.icon} /></span>
            <div>
              <h4 class="mb-1 font-semibold text-accent">{c.title}</h4>
              {c.lines.map((l) => c.href ? <a href={c.href} class="block hover:text-primary">{l}</a> : <p>{l}</p>)}
              {c.note && <p class="text-sm opacity-70">{c.note}</p>}
            </div>
          </div>
        ))}
      </div>
      {socials.length > 0 && (
        <div class="mt-8">
          <h4 class="mb-4 font-semibold text-accent">Follow me</h4>
          <div class="flex gap-3">
            {socials.map((k) => (
              <a href={s[k]} target="_blank" rel="noopener" aria-label={k} class="rounded-lg bg-primary p-3 text-white transition-all duration-300 hover:-translate-y-1 hover:bg-secondary hover:shadow-lg"><Icon name={k} /></a>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="rounded-xl bg-white p-8 text-ink shadow-lg" data-reveal="right">
      {d.formTitle && <h3 class="mb-8 text-2xl font-bold text-accent">{d.formTitle}</h3>}
      <form action="/api/contact" method="post" data-ajax class="space-y-5">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <label class="block"><span class="mb-1 block text-sm font-medium">First name *</span>
            <input name="firstName" required minlength="2" maxlength="80" autocomplete="given-name" class="field" /></label>
          <label class="block"><span class="mb-1 block text-sm font-medium">Last name *</span>
            <input name="lastName" required maxlength="80" autocomplete="family-name" class="field" /></label>
        </div>
        <label class="block"><span class="mb-1 block text-sm font-medium">Email address *</span>
          <input type="email" name="email" required maxlength="200" autocomplete="email" class="field" /></label>
        <label class="block"><span class="mb-1 block text-sm font-medium">Phone number</span>
          <input type="tel" name="phone" maxlength="40" autocomplete="tel" class="field" /></label>
        {d.serviceOptions.length > 0 && (
          <label class="block"><span class="mb-1 block text-sm font-medium">Service of interest</span>
            <select name="service" class="field">
              <option value="">Select a service</option>
              {d.serviceOptions.map((o: string) => <option>{o}</option>)}
            </select>
          </label>
        )}
        <label class="block"><span class="mb-1 block text-sm font-medium">Tell me about your style goals</span>
          <textarea name="message" rows="4" maxlength="5000" class="field"
            placeholder="What would you like to achieve with your style? What challenges are you facing?"></textarea></label>
        <label class="flex items-start gap-3 text-sm">
          <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 accent-primary" />
          <span>I agree to be contacted about my enquiry. *</span>
        </label>
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <button type="submit" class="btn-primary w-full py-4 text-lg">{d.buttonLabel || 'Send'}</button>
        {d.footnote && <p class="text-center text-sm opacity-70">{d.footnote}</p>}
        <p data-status class="min-h-6 text-center font-medium" data-success={d.successMessage} role="status"></p>
      </form>
    </div>
  </div>
</Wrapper>
