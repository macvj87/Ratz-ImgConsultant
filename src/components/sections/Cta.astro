---
import Wrapper from './Wrapper.astro';
import { paragraphs } from '../../lib/util';
import type { Section } from '../../lib/sections';
interface Props { section: Section }
const { section } = Astro.props;
const d = section.data;
---
<Wrapper section={section}>
  <div class="blob -top-20 left-1/4 h-64 w-64 bg-white" aria-hidden="true"></div>
  <div class="blob right-10 -bottom-24 h-72 w-72 bg-primary" aria-hidden="true"></div>
  <div class="relative text-center" data-reveal="zoom">
    {d.heading && <h2 class="section-title">{d.heading}</h2>}
    {paragraphs(d.text).map((p) => <p class="section-intro mb-8">{p}</p>)}
    {d.buttonLabel && (
      <a href={d.buttonLink} class="btn btn-shine bg-page px-8 py-4 text-lg text-accent shadow-lg hover:-translate-y-1 hover:scale-105 hover:bg-white hover:shadow-2xl">{d.buttonLabel}</a>
    )}
  </div>
</Wrapper>
