---
import Wrapper from './Wrapper.astro';
import { img, paragraphs } from '../../lib/util';
import type { Section } from '../../lib/sections';
interface Props { section: Section }
const { section } = Astro.props;
const d = section.data;
const left = d.imageSide === 'left';
---
<Wrapper section={section}>
  <div class:list={['grid grid-cols-1 items-center gap-12', d.image && 'lg:grid-cols-2']}>
    {d.image && (
      <div class:list={['relative', !left && 'lg:order-2']} data-reveal={left ? 'left' : 'right'}>
        <div class:list={['absolute inset-0 rounded-2xl bg-primary/20', left ? '-translate-x-4 translate-y-4' : 'translate-x-4 translate-y-4']} aria-hidden="true"></div>
        <div class="zoom-img relative rounded-2xl shadow-xl">
          <img src={img(d.image, 800)} alt={d.heading} loading="lazy" class="w-full scale-110" data-parallax />
        </div>
      </div>
    )}
    <div data-reveal={d.image ? (left ? 'right' : 'left') : true}>
      {d.heading && <h2 class="section-title mb-4">{d.heading}</h2>}
      {d.subheading && <h3 class="mb-6 text-2xl font-semibold text-primary">{d.subheading}</h3>}
      <div class="space-y-4 text-lg opacity-90">
        {paragraphs(d.text).map((p) => <p>{p}</p>)}
      </div>
      {d.buttonLabel && <a href={d.buttonLink} class="btn-primary mt-8">{d.buttonLabel}</a>}
    </div>
  </div>
</Wrapper>
