---
// Renders one admin form field from its definition in lib/sections.ts.
import Icon from '../Icon.astro';
import ImageInput from './ImageInput.astro';
import type { Field } from '../../lib/sections';

interface Props { field: Field; name: string; value: any }
const { field, name, value } = Astro.props;
const id = name.replace(/[^\w-]/g, '_');
---
{field.type === 'list' ? (
  <fieldset class="rounded-xl border border-stone-200 bg-stone-50 p-4" data-list={name}>
    <legend class="px-1 text-sm font-semibold text-stone-800">{field.label}</legend>
    <div data-items class="space-y-3">
      {(value ?? []).map((item: any, i: number) => (
        <div data-item class="rounded-lg border border-stone-200 bg-white p-4">
          <div class="mb-3 flex items-center gap-1">
            <span class="mr-auto text-sm font-medium text-stone-600" data-item-title>{field.itemLabel} {i + 1}</span>
            <button type="button" class="a-icon-btn" data-move="-1" aria-label="Move up"><Icon name="arrow-up" size={16} /></button>
            <button type="button" class="a-icon-btn" data-move="1" aria-label="Move down"><Icon name="arrow-down" size={16} /></button>
            <button type="button" class="a-icon-btn hover:text-red-700" data-remove aria-label={`Remove ${field.itemLabel.toLowerCase()}`}><Icon name="trash" size={16} /></button>
          </div>
          <div class="space-y-4">
            {field.fields.map((f) => <Astro.self field={f} name={`${name}.${i}.${f.name}`} value={item?.[f.name]} />)}
          </div>
        </div>
      ))}
    </div>
    <template data-template>
      <div data-item class="rounded-lg border border-stone-200 bg-white p-4">
        <div class="mb-3 flex items-center gap-1">
          <span class="mr-auto text-sm font-medium text-stone-600" data-item-title>{field.itemLabel}</span>
          <button type="button" class="a-icon-btn" data-move="-1" aria-label="Move up"><Icon name="arrow-up" size={16} /></button>
          <button type="button" class="a-icon-btn" data-move="1" aria-label="Move down"><Icon name="arrow-down" size={16} /></button>
          <button type="button" class="a-icon-btn hover:text-red-700" data-remove aria-label={`Remove ${field.itemLabel.toLowerCase()}`}><Icon name="trash" size={16} /></button>
        </div>
        <div class="space-y-4">
          {field.fields.map((f) => <Astro.self field={f} name={`${name}.__i__.${f.name}`} value={undefined} />)}
        </div>
      </div>
    </template>
    <button type="button" class="a-btn-secondary mt-3" data-add data-item-label={field.itemLabel}>
      <Icon name="plus" size={16} /> Add {field.itemLabel.toLowerCase()}
    </button>
  </fieldset>
) : (
  <div>
    <label class="a-label" for={id}>{field.label}</label>
    {field.type === 'text' && <input id={id} name={name} value={value ?? ''} class="a-input" />}
    {field.type === 'number' && <input id={id} name={name} type="number" min="0" value={value ?? ''} class="a-input w-32" />}
    {field.type === 'textarea' && <textarea id={id} name={name} rows="4" class="a-input">{value ?? ''}</textarea>}
    {field.type === 'lines' && <textarea id={id} name={name} rows="5" class="a-input">{(value ?? []).join('\n')}</textarea>}
    {field.type === 'select' && (
      <select id={id} name={name} class="a-input w-auto">
        {field.options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
      </select>
    )}
    {field.type === 'image' && <ImageInput id={id} name={name} value={value} />}
    {field.help && <p class="a-help">{field.help}</p>}
  </div>
)}
