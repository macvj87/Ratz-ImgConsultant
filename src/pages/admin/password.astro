---
import Admin from '../../layouts/Admin.astro';
import { MIN_PASSWORD_LENGTH, checkNewPassword, passwordMatches, setPassword, startSession } from '../../lib/auth';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  if (!(await passwordMatches(String(form.get('current') ?? '')))) {
    error = 'Your current password isn’t right.';
  } else {
    error = checkNewPassword(password, String(form.get('confirm') ?? ''));
  }
  if (!error) {
    await setPassword(password);
    // Changing the password signs out every device, so sign this one back in.
    await startSession(Astro.cookies, Astro.url.protocol === 'https:');
    return Astro.redirect('/admin/password?changed=1');
  }
}
---
<Admin title="Password">
  {Astro.url.searchParams.has('changed') && (
    <p class="a-notice" role="status">Password changed. Any other devices that were logged in have been signed out.</p>
  )}
  {error && <p class="a-error" role="alert">{error}</p>}
  <form method="post" class="a-card max-w-md space-y-4">
    <h2 class="font-semibold">Change your password</h2>
    <div>
      <label class="a-label" for="current">Current password</label>
      <input id="current" name="current" type="password" required autocomplete="current-password" class="a-input" />
    </div>
    <div>
      <label class="a-label" for="password">New password</label>
      <input id="password" name="password" type="password" required minlength={MIN_PASSWORD_LENGTH} autocomplete="new-password" class="a-input" />
      <p class="a-help">At least {MIN_PASSWORD_LENGTH} characters. A short sentence is easy to remember and hard to guess.</p>
    </div>
    <div>
      <label class="a-label" for="confirm">Type the new password again</label>
      <input id="confirm" name="confirm" type="password" required autocomplete="new-password" class="a-input" />
    </div>
    <button class="a-btn-primary">Change password</button>
  </form>
  <p class="mt-6 max-w-md text-sm text-stone-600">
    Forgotten it? Log out, then use “Forgot password?” on the login page to get a reset link by email.
  </p>
</Admin>
