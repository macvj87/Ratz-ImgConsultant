---
import Admin from '../../layouts/Admin.astro';
import Icon from '../../components/Icon.astro';
import { deleteEnquiry, listEnquiries, updateEnquiry } from '../../lib/store';
import { formatDateTime, paragraphs } from '../../lib/util';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id'));
  const action = form.get('action');
  if (action === 'delete') await deleteEnquiry(id);
  else await updateEnquiry(id, { read: action === 'read' });
  return Astro.redirect('/admin/enquiries');
}
const enquiries = await listEnquiries();
---
<Admin title="Enquiries">
  <p class="mb-6 text-sm text-stone-600">Messages sent through the contact form, newest first. You also get an email for each new one (set the address under “Details & theme”).</p>
  {enquiries.length === 0 && <p class="text-stone-600">No enquiries yet.</p>}
  <ul class="space-y-3">
    {enquiries.map((e) => (
      <li class:list={['a-card', !e.read && 'border-l-4 border-l-emerald-600']}>
        <div class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 class="font-semibold">{e.firstName} {e.lastName}</h2>
          {!e.read && <span class="rounded-full bg-emerald-100 px-2 text-xs font-medium text-emerald-800">New</span>}
          <span class="ml-auto text-xs text-stone-500">{formatDateTime(e.createdAt)}</span>
        </div>
        <dl class="mb-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
          <dt class="text-stone-500">Email</dt><dd><a class="text-emerald-800 underline" href={`mailto:${e.email}`}>{e.email}</a></dd>
          {e.phone && <><dt class="text-stone-500">Phone</dt><dd><a class="text-emerald-800 underline" href={`tel:${e.phone.replace(/\s/g, '')}`}>{e.phone}</a></dd></>}
          {e.service && <><dt class="text-stone-500">Service</dt><dd>{e.service}</dd></>}
        </dl>
        {e.message && <div class="space-y-2 rounded-lg bg-stone-50 p-3 text-sm whitespace-pre-line">{paragraphs(e.message).map((p) => <p>{p}</p>)}</div>}
        <form method="post" class="mt-3 flex flex-wrap gap-2">
          <input type="hidden" name="id" value={e.id} />
          <a href={`mailto:${e.email}?subject=${encodeURIComponent('Re: your enquiry')}`} class="a-btn-primary"><Icon name="mail" size={16} /> Reply</a>
          <button name="action" value={e.read ? 'unread' : 'read'} class="a-btn-secondary">{e.read ? 'Mark as new' : 'Mark as read'}</button>
          <button name="action" value="delete" class="a-btn-danger ml-auto" data-confirm="Delete this enquiry?">Delete</button>
        </form>
      </li>
    ))}
  </ul>
</Admin>
